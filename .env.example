APP_NAME=StoryWriter
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses SQLite
DB_CONNECTION=sqlite

# For staging/production, use PostgreSQL:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=storywriter_staging
# DB_USERNAME=storywriter_app
# DB_PASSWORD=your_secure_password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Where generated story images/audio are written. "public" serves them from
# public/storage (run `php artisan storage:link` once); staging/production use "s3".
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
# How long a signed URL for a story illustration lasts, in minutes. The default
# is a day, so a storybook left open on a tablet doesn't lose its pictures.
MEDIA_URL_TTL_MINUTES=1440
# How long a signed URL stays byte-identical, in minutes. Requests inside one
# window get the same URL back, so the app can cache pictures instead of
# re-downloading them. 0 signs at the current instant and disables caching.
MEDIA_URL_WINDOW_MINUTES=60

# AWS SSM Parameter Store (staging/production only)
# Set AWS_SSM_ENABLED=true in staging/production to load secrets from Parameter Store
AWS_SSM_ENABLED=false
# AWS_SSM_PATH_PREFIX=/storywriter/staging/
# AWS_SSM_CACHE_TTL=300

# API Keys (for local development - staging/production use Parameter Store)
TOGETHER_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Heirloom narrative synthesis (Groq console)
GROQ_API_KEY=
# Optional. Defaults to openai/gpt-oss-120b. Uncomment to override -- leave it
# commented rather than blank, because a blank value overrides the default too.
# GROQ_MODEL=

# Authentication
# Per-IP per-minute ceiling on the register and login routes, web and JSON alike.
AUTH_RATE_LIMIT_PER_MINUTE=10
# Set false to close both signup paths (POST /api/v1/auth/register and the
# /register web form). Existing accounts still log in. Both staging and
# production set this false in their deploy workflows -- production because the
# pre-release is invite-only. Create accounts with `php artisan users:create`.
REGISTRATION_ENABLED=true

# PostHog Analytics
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
# Production sends events automatically. Set to true to also send from local/staging
# for testing — events are stamped with an `environment` property for filtering.
POSTHOG_FORCE_ENABLE=false

VITE_APP_NAME="${APP_NAME}"
